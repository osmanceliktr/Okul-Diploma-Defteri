{
  "name": "diploma-kayit",
  "version": "1.2.0",
  "private": true,
  "description": "DİPLOMA kayıt ve belge üretim uygulaması",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
